---
import { AUTHOR_NAME, GITHUB_USERNAME } from '../consts';
const today = new Date();
---

<footer>
	<div class="inner">
		<p>&copy; {today.getFullYear()} {AUTHOR_NAME}. Built with Astro.</p>
		<div class="links">
			<a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" rel="noopener">GitHub</a>
			<span aria-hidden="true">·</span>
			<a href="/rss.xml">RSS</a>
		</div>
	</div>
</footer>
<style>
	footer {
		margin-top: 4em;
		border-top: 1px solid var(--border);
		padding: 2em 1em 3em;
		color: var(--fg-subtle);
		font-size: 0.9em;
	}
	.inner {
		max-width: 760px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		flex-wrap: wrap;
	}
	p {
		margin: 0;
	}
	.links {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
	}
	.links a {
		color: var(--fg-muted);
	}
	.links a:hover {
		color: var(--accent);
	}
</style>
