---
interface Props {
	category: string;
	size?: 'sm' | 'md';
	asLink?: boolean;
}
const { category, size = 'sm', asLink = true } = Astro.props;
const Tag = asLink ? 'a' : 'span';
const href = asLink ? `/category/${encodeURIComponent(category)}/` : undefined;
---

<Tag class:list={['badge', size]} href={href}>{category}</Tag>

<style>
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		padding: 0.25em 0.65em;
		border-radius: 999px;
		font-size: 0.78em;
		font-weight: 600;
		color: var(--accent);
		background: var(--accent-soft);
		border: 1px solid transparent;
		text-decoration: none;
		line-height: 1.4;
		transition: background 0.15s ease, border-color 0.15s ease;
	}
	.badge.md {
		font-size: 0.85em;
		padding: 0.3em 0.75em;
	}
	a.badge:hover {
		background: transparent;
		border-color: var(--accent);
	}
</style>
