---
interface Heading {
	depth: number;
	slug: string;
	text: string;
}
interface Props {
	headings: Heading[];
}
const { headings } = Astro.props;

// h2, h3 만 TOC에 포함. h1은 글 제목용이라 제외.
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
	items.length > 0 && (
		<aside class="toc" aria-label="목차">
			<div class="toc-title">목차</div>
			<ul>
				{items.map((h) => (
					<li class:list={[`depth-${h.depth}`]}>
						<a href={`#${h.slug}`} data-toc-link={h.slug}>
							{h.text}
						</a>
					</li>
				))}
			</ul>
		</aside>
	)
}

<style>
	.toc {
		position: sticky;
		top: 2em;
		font-size: 0.88em;
		max-height: calc(100vh - 4em);
		overflow-y: auto;
		padding-left: 1em;
		border-left: 1px solid var(--border);
	}
	.toc-title {
		font-weight: 700;
		color: var(--fg-muted);
		margin-bottom: 0.75em;
		font-size: 0.85em;
		text-transform: uppercase;
		letter-spacing: 0.08em;
	}
	ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.1em;
	}
	li.depth-3 {
		padding-left: 1em;
		font-size: 0.95em;
	}
	a {
		display: block;
		padding: 0.3em 0;
		color: var(--fg-muted);
		text-decoration: none;
		border-left: 2px solid transparent;
		margin-left: -1em;
		padding-left: calc(1em - 2px);
		line-height: 1.4;
		transition: color 0.1s ease, border-color 0.1s ease;
	}
	a:hover {
		color: var(--fg);
	}
	a.active {
		color: var(--accent);
		border-left-color: var(--accent);
		font-weight: 600;
	}
</style>

<script is:inline>
	(function () {
		// Scrollspy: 현재 뷰포트에 들어온 섹션을 TOC에서 하이라이트
		const links = Array.from(document.querySelectorAll('[data-toc-link]'));
		if (!links.length) return;

		const targets = links
			.map((a) => {
				const slug = a.getAttribute('data-toc-link');
				const el = slug ? document.getElementById(slug) : null;
				return el ? { a, el } : null;
			})
			.filter(Boolean);

		if (!targets.length) return;

		const observer = new IntersectionObserver(
			(entries) => {
				const visible = entries
					.filter((e) => e.isIntersecting)
					.sort((a, b) => b.intersectionRatio - a.intersectionRatio);
				if (!visible.length) return;
				const topMost = visible[0].target;
				links.forEach((a) => a.classList.toggle('active', a.getAttribute('data-toc-link') === topMost.id));
			},
			{ rootMargin: '-20% 0px -70% 0px', threshold: [0, 0.25, 0.5, 1] },
		);
		targets.forEach((t) => t && observer.observe(t.el));
	})();
</script>
