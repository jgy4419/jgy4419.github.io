---
import { AUTHOR_NAME, GITHUB_USERNAME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Search from './Search.astro';
import ThemeToggle from './ThemeToggle.astro';
---

<aside class="sidebar" id="sidebar">
	<a href="/" class="profile">
		<img class="avatar" src="/avatar.png" alt={AUTHOR_NAME} width="96" height="96" />
		<div class="name">{AUTHOR_NAME}</div>
		<div class="tagline">{SITE_DESCRIPTION}</div>
	</a>

	<nav class="nav">
		<HeaderLink href="/"><span class="icon">🏠</span>Home</HeaderLink>
		<HeaderLink href="/blog"><span class="icon">📝</span>Blog</HeaderLink>
		<HeaderLink href="/category"><span class="icon">📁</span>Category</HeaderLink>
		<HeaderLink href="/tag"><span class="icon">🏷️</span>Tag</HeaderLink>
		<HeaderLink href="/about"><span class="icon">👤</span>About</HeaderLink>
	</nav>

	<div class="search-wrap">
		<Search />
	</div>

	<div class="footer">
		<div class="social">
			<a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" rel="noopener" aria-label="GitHub">
				<svg viewBox="0 0 16 16" width="20" height="20" aria-hidden="true">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
			<a href="/rss.xml" aria-label="RSS">
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<path
						fill="currentColor"
						d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93z"
					></path>
				</svg>
			</a>
			<a href="/admin/" aria-label="글쓰기">
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none">
					<path
						d="M12 20h9M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"
						stroke-linejoin="round"></path>
				</svg>
			</a>
			<ThemeToggle />
		</div>
		<div class="copyright">&copy; {new Date().getFullYear()} {SITE_TITLE}</div>
	</div>
</aside>

<style>
	.sidebar {
		display: flex;
		flex-direction: column;
		gap: 1.5em;
		padding: 2em 1.5em;
		border-right: 1px solid var(--border);
		background: var(--bg-elevated);
	}
	.profile {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.5em;
		text-decoration: none;
		color: inherit;
		padding-bottom: 1.5em;
		border-bottom: 1px solid var(--border);
	}
	.avatar {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		object-fit: cover;
		background: var(--bg-muted);
		box-shadow: var(--shadow-md);
		border: 2px solid var(--bg-elevated);
	}
	.name {
		font-size: 1.3em;
		font-weight: 700;
		letter-spacing: -0.02em;
	}
	.tagline {
		font-size: 0.85em;
		color: var(--fg-muted);
		line-height: 1.5;
	}
	.nav {
		display: flex;
		flex-direction: column;
		gap: 0.1em;
	}
	.nav :global(a) {
		display: flex;
		align-items: center;
		gap: 0.75em;
		padding: 0.7em 0.9em;
		border-radius: var(--radius-sm);
		color: var(--fg-muted);
		text-decoration: none;
		font-weight: 500;
		font-size: 0.95em;
		transition: color 0.15s ease, background 0.15s ease;
	}
	.nav :global(a:hover) {
		color: var(--fg);
		background: var(--bg-muted);
	}
	.nav :global(a.active) {
		color: var(--accent);
		background: var(--accent-soft);
	}
	.icon {
		font-size: 1.1em;
		width: 1.4em;
		display: inline-flex;
		justify-content: center;
	}
	.search-wrap {
		margin-top: auto;
	}
	.footer {
		display: flex;
		flex-direction: column;
		gap: 0.75em;
		padding-top: 1em;
		border-top: 1px solid var(--border);
	}
	.social {
		display: flex;
		gap: 0.3em;
		justify-content: center;
		align-items: center;
		flex-wrap: wrap;
	}
	.social a {
		width: 36px;
		height: 36px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		border-radius: var(--radius-sm);
		color: var(--fg-muted);
		transition: color 0.15s ease, background 0.15s ease;
	}
	.social a:hover {
		color: var(--fg);
		background: var(--bg-muted);
	}
	.copyright {
		text-align: center;
		color: var(--fg-subtle);
		font-size: 0.75em;
	}
</style>
