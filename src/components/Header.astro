---
import { GITHUB_USERNAME, SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href="/" class="brand">
			<span class="logo" aria-hidden="true">0</span>
			<span class="title">{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href={`https://github.com/${GITHUB_USERNAME}`} target="_blank" rel="noopener">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
			<a href="/rss.xml" aria-label="RSS">
				<span class="sr-only">RSS</span>
				<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
					<path
						fill="currentColor"
						d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: saturate(180%) blur(12px);
		-webkit-backdrop-filter: saturate(180%) blur(12px);
		background: color-mix(in srgb, var(--bg) 85%, transparent);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
		max-width: 960px;
		margin: 0 auto;
		padding: 0.9em 1.25em;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6em;
		color: var(--fg);
		text-decoration: none;
		font-weight: 700;
	}
	.brand:hover {
		color: var(--fg);
	}
	.logo {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		border-radius: 8px;
		background: var(--gradient);
		color: #fff;
		font-weight: 800;
		font-size: 0.95em;
		letter-spacing: 0;
		font-family: var(--font-mono);
		box-shadow: var(--shadow-sm);
	}
	.title {
		font-size: 1.02em;
		letter-spacing: -0.01em;
	}
	.internal-links {
		display: flex;
		gap: 0.25em;
	}
	.internal-links :global(a) {
		padding: 0.45em 0.85em;
		border-radius: var(--radius-sm);
		color: var(--fg-muted);
		font-size: 0.95em;
		font-weight: 500;
		text-decoration: none;
		transition: color 0.15s ease, background 0.15s ease;
	}
	.internal-links :global(a:hover) {
		color: var(--fg);
		background: var(--bg-muted);
	}
	.internal-links :global(a.active) {
		color: var(--accent);
		background: var(--accent-soft);
	}
	.social-links {
		display: flex;
		gap: 0.25em;
	}
	.social-links a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 36px;
		height: 36px;
		border-radius: var(--radius-sm);
		color: var(--fg-muted);
		transition: color 0.15s ease, background 0.15s ease;
	}
	.social-links a:hover {
		color: var(--fg);
		background: var(--bg-muted);
	}
	@media (max-width: 640px) {
		.title {
			display: none;
		}
		.internal-links :global(a) {
			padding: 0.4em 0.6em;
			font-size: 0.9em;
		}
	}
</style>
