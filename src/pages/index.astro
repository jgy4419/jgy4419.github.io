---
import CategoryBadge from '../components/CategoryBadge.astro';
import FormattedDate from '../components/FormattedDate.astro';
import ReadingTime from '../components/ReadingTime.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getPublishedPosts, readingTimeMin } from '../utils/posts';

const posts = (await getPublishedPosts()).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 8);
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="hero">
		<h1>안녕하세요, <span class="gradient-text">{AUTHOR_NAME}</span>입니다 👋</h1>
		<p class="tagline">{SITE_DESCRIPTION}</p>
	</section>

	<section>
		<div class="section-head">
			<h2>최근 글</h2>
			<a href="/blog" class="see-all">전체 보기 →</a>
		</div>
		<ul class="post-grid" data-pagefind-ignore>
			{
				latest.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`} class="card">
							{post.data.heroImage && (
								<div class="thumb">
									<img src={post.data.heroImage} alt="" loading="lazy" />
								</div>
							)}
							<div class="meta">
								<CategoryBadge category={post.data.category} asLink={false} />
								<h3>{post.data.title}</h3>
								<p class="desc">{post.data.description}</p>
								<div class="meta">
									<time>
										<FormattedDate date={post.data.pubDate} />
									</time>
									<span aria-hidden="true">·</span>
									<ReadingTime minutes={readingTimeMin(post.body)} />
								</div>
							</div>
						</a>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.hero {
		padding: 2em 0 2.5em;
		text-align: left;
	}
	.hero h1 {
		font-size: 2.25em;
		margin: 0 0 0.3em;
		letter-spacing: -0.03em;
	}
	.tagline {
		color: var(--fg-muted);
		font-size: 1.05em;
		margin: 0;
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin: 1em 0 1.5em;
	}
	.section-head h2 {
		margin: 0;
		font-size: 1.5em;
	}
	.see-all {
		color: var(--fg-muted);
		font-size: 0.95em;
	}
	.see-all:hover {
		color: var(--accent);
	}

	.post-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
		gap: 1.5em;
	}
	.card {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		color: inherit;
		text-decoration: none;
		background: var(--bg-elevated);
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
	}
	.card:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-lg);
		border-color: var(--accent);
	}
	.thumb {
		aspect-ratio: 16 / 9;
		overflow: hidden;
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.4s ease;
	}
	.card:hover .thumb img {
		transform: scale(1.03);
	}
	.meta {
		padding: 1.1em 1.25em 1.3em;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5em;
		flex: 1;
	}
	.meta h3 {
		margin: 0;
		font-size: 1.1em;
		line-height: 1.4;
	}
	.desc {
		color: var(--fg-muted);
		font-size: 0.92em;
		margin: 0;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		line-clamp: 2;
		overflow: hidden;
	}
	.meta {
		margin-top: auto;
		display: flex;
		align-items: center;
		gap: 0.5em;
		color: var(--fg-subtle);
		font-size: 0.85em;
	}
	time {
		color: var(--fg-subtle);
	}
</style>
