---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { AUTHOR_NAME, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const latest = posts.slice(0, 6);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="avatar" aria-hidden="true">0</div>
				<h1>
					안녕하세요, <span class="gradient-text">{AUTHOR_NAME}</span>입니다 👋
				</h1>
				<p class="tagline">{SITE_DESCRIPTION}</p>
			</section>

			<section class="latest">
				<div class="section-head">
					<h2>최근 글</h2>
					<a href="/blog" class="see-all">전체 보기 →</a>
				</div>
				<ul class="post-grid">
					{
						latest.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`} class="card">
									{post.data.heroImage && (
										<div class="thumb">
											<img src={post.data.heroImage} alt="" loading="lazy" />
										</div>
									)}
									<div class="meta">
										<h3>{post.data.title}</h3>
										<p class="desc">{post.data.description}</p>
										<time>
											<FormattedDate date={post.data.pubDate} />
										</time>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
		<style>
			.hero {
				text-align: center;
				padding: 4em 0 3em;
			}
			.avatar {
				width: 80px;
				height: 80px;
				margin: 0 auto 1.5em;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				background: var(--gradient);
				color: #fff;
				font-weight: 800;
				font-size: 2.2em;
				font-family: var(--font-mono);
				box-shadow: var(--shadow-md);
			}
			.hero h1 {
				font-size: 2.5em;
				margin: 0 0 0.4em;
				letter-spacing: -0.03em;
			}
			.tagline {
				color: var(--fg-muted);
				font-size: 1.1em;
				margin: 0;
			}

			.section-head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				margin: 1em 0 1.5em;
			}
			.section-head h2 {
				margin: 0;
				font-size: 1.5em;
			}
			.see-all {
				color: var(--fg-muted);
				font-size: 0.95em;
			}
			.see-all:hover {
				color: var(--accent);
			}

			.post-grid {
				list-style: none;
				padding: 0;
				margin: 0;
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.5em;
			}
			.post-grid li {
				margin: 0;
			}
			.post-grid a.card {
				display: flex;
				flex-direction: column;
				height: 100%;
				overflow: hidden;
				color: inherit;
				text-decoration: none;
			}
			.thumb {
				aspect-ratio: 16 / 9;
				overflow: hidden;
			}
			.thumb :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				display: block;
				transition: transform 0.4s ease;
			}
			.post-grid a.card:hover .thumb :global(img) {
				transform: scale(1.03);
			}
			.meta {
				padding: 1.1em 1.25em 1.3em;
				display: flex;
				flex-direction: column;
				align-items: flex-start;
				gap: 0.5em;
				flex: 1;
			}
			.meta h3 {
				margin: 0;
				font-size: 1.1em;
				line-height: 1.4;
				letter-spacing: -0.015em;
			}
			.desc {
				color: var(--fg-muted);
				font-size: 0.92em;
				line-height: 1.55;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				line-clamp: 2;
				overflow: hidden;
			}
			time {
				margin-top: auto;
				color: var(--fg-subtle);
				font-size: 0.85em;
			}

			@media (max-width: 640px) {
				.hero {
					padding: 2.5em 0 2em;
				}
				.hero h1 {
					font-size: 1.9em;
				}
				.avatar {
					width: 64px;
					height: 64px;
					font-size: 1.8em;
				}
			}
		</style>
	</body>
</html>
