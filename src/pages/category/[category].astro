---
import CategoryBadge from '../../components/CategoryBadge.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import ReadingTime from '../../components/ReadingTime.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE_TITLE } from '../../consts';
import { getPublishedPosts, readingTimeMin } from '../../utils/posts';

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	const byCategory = new Map<string, typeof posts>();
	for (const p of posts) {
		const c = p.data.category;
		if (!byCategory.has(c)) byCategory.set(c, []);
		byCategory.get(c)!.push(p);
	}
	return [...byCategory.entries()].map(([category, items]) => ({
		params: { category },
		props: {
			category,
			posts: items.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { category, posts } = Astro.props;
---

<BaseLayout
	title={`${category} · ${SITE_TITLE}`}
	description={`${category} 카테고리의 글 모음`}
>
	<section class="page-head">
		<a href="/category/" class="back">← 전체 카테고리</a>
		<h1>{category}</h1>
		<p>글 {posts.length}개</p>
	</section>
	<ul class="post-list" data-pagefind-ignore>
		{
			posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`} class="row">
						{post.data.heroImage && (
							<div class="thumb">
								<img src={post.data.heroImage} alt="" loading="lazy" />
							</div>
						)}
						<div class="body">
							<CategoryBadge category={post.data.category} asLink={false} />
							<h2>{post.data.title}</h2>
							<p class="desc">{post.data.description}</p>
							<div class="meta">
								<time>
									<FormattedDate date={post.data.pubDate} />
								</time>
								<span aria-hidden="true">·</span>
								<ReadingTime minutes={readingTimeMin(post.body)} />
							</div>
						</div>
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>

<style>
	.page-head {
		padding: 1.5em 0 2em;
		border-bottom: 1px solid var(--border);
		margin-bottom: 1.5em;
	}
	.back {
		display: inline-block;
		color: var(--fg-muted);
		font-size: 0.9em;
		margin-bottom: 0.5em;
	}
	.back:hover {
		color: var(--accent);
	}
	.page-head h1 {
		margin: 0 0 0.25em;
		font-size: 2em;
		letter-spacing: -0.03em;
	}
	.page-head p {
		margin: 0;
		color: var(--fg-muted);
	}
	.post-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75em;
	}
	.row {
		display: flex;
		gap: 1.25em;
		padding: 1em;
		color: inherit;
		text-decoration: none;
		border-radius: var(--radius-lg);
		border: 1px solid transparent;
		transition: background 0.2s ease, border-color 0.2s ease;
	}
	.row:hover {
		background: var(--bg-elevated);
		border-color: var(--border);
	}
	.thumb {
		flex: 0 0 160px;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: var(--radius-md);
	}
	.thumb img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.body {
		display: flex;
		flex: 1;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.4em;
		min-width: 0;
	}
	.body h2 {
		margin: 0;
		font-size: 1.15em;
	}
	.desc {
		margin: 0;
		color: var(--fg-muted);
		font-size: 0.93em;
	}
	.meta {
		display: flex;
		align-items: center;
		gap: 0.5em;
		color: var(--fg-subtle);
		font-size: 0.85em;
	}
	time {
		color: var(--fg-subtle);
	}
	@media (max-width: 640px) {
		.row {
			flex-direction: column;
		}
		.thumb {
			flex: 0 0 auto;
			width: 100%;
			aspect-ratio: 16 / 9;
		}
	}
</style>
