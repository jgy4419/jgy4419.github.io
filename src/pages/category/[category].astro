---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('blog');
	const byCategory = new Map<string, typeof posts>();
	for (const p of posts) {
		const c = p.data.category;
		if (!byCategory.has(c)) byCategory.set(c, []);
		byCategory.get(c)!.push(p);
	}
	return [...byCategory.entries()].map(([category, items]) => ({
		params: { category },
		props: {
			category,
			posts: items.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
		},
	}));
}

const { category, posts } = Astro.props;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead
			title={`${category} · ${SITE_TITLE}`}
			description={`${category} 카테고리의 글 모음`}
		/>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-head">
				<a href="/category/" class="back">← 전체 카테고리</a>
				<h1>{category}</h1>
				<p>글 {posts.length}개</p>
			</section>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`} class="row">
								{post.data.heroImage && (
									<div class="thumb">
										<img src={post.data.heroImage} alt="" loading="lazy" />
									</div>
								)}
								<div class="body">
									<h2>{post.data.title}</h2>
									<p class="desc">{post.data.description}</p>
									<time>
										<FormattedDate date={post.data.pubDate} />
									</time>
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
		<style>
			.page-head {
				padding: 2em 0 2.5em;
				border-bottom: 1px solid var(--border);
				margin-bottom: 2em;
			}
			.back {
				display: inline-block;
				color: var(--fg-muted);
				font-size: 0.9em;
				margin-bottom: 0.75em;
			}
			.back:hover {
				color: var(--accent);
			}
			.page-head h1 {
				margin: 0 0 0.25em;
				font-size: 2.25em;
				letter-spacing: -0.03em;
			}
			.page-head p {
				margin: 0;
				color: var(--fg-muted);
			}
			.post-list {
				list-style: none;
				padding: 0;
				margin: 0;
				display: flex;
				flex-direction: column;
				gap: 1em;
			}
			.post-list li {
				margin: 0;
			}
			.row {
				display: grid;
				grid-template-columns: 160px 1fr;
				gap: 1.25em;
				padding: 1em;
				color: inherit;
				text-decoration: none;
				border-radius: var(--radius-lg);
				border: 1px solid transparent;
				transition: background 0.2s ease, border-color 0.2s ease;
			}
			.row:hover {
				background: var(--bg-elevated);
				border-color: var(--border);
			}
			.thumb {
				aspect-ratio: 16 / 10;
				overflow: hidden;
				border-radius: var(--radius-md);
			}
			.thumb :global(img) {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0;
				display: block;
			}
			.body {
				display: flex;
				flex-direction: column;
				gap: 0.4em;
				min-width: 0;
			}
			.body h2 {
				margin: 0;
				font-size: 1.2em;
				line-height: 1.4;
			}
			.desc {
				margin: 0;
				color: var(--fg-muted);
				font-size: 0.95em;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				line-clamp: 2;
				overflow: hidden;
			}
			time {
				margin-top: auto;
				color: var(--fg-subtle);
				font-size: 0.85em;
			}
			@media (max-width: 640px) {
				.row {
					grid-template-columns: 1fr;
					gap: 0.75em;
				}
				.thumb {
					aspect-ratio: 16 / 9;
				}
			}
		</style>
	</body>
</html>
