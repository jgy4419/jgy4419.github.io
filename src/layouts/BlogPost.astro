---
import type { CollectionEntry } from 'astro:content';
import CategoryBadge from '../components/CategoryBadge.astro';
import CopyCodeButton from '../components/CopyCodeButton.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import PostNav from '../components/PostNav.astro';
import ReadingTime from '../components/ReadingTime.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import Toc from '../components/Toc.astro';
import type { Post } from '../utils/posts';
import BaseLayout from './BaseLayout.astro';

type Frontmatter = CollectionEntry<'blog'>['data'];
interface Heading {
	depth: number;
	slug: string;
	text: string;
}
interface Props extends Frontmatter {
	headings: Heading[];
	prev?: Post;
	next?: Post;
	related: Post[];
	reading: number;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	category,
	tags,
	draft,
	headings,
	prev,
	next,
	related,
	reading,
} = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage} wide={true}>
	<ScrollProgress />
	<div class="post-layout">
		<article data-pagefind-body>
			<header class="title">
				<div class="meta-row">
					<CategoryBadge category={category} size="md" />
					{draft && <span class="draft">비공개 (dev 미리보기)</span>}
					<time>
						<FormattedDate date={pubDate} />
						{
							updatedDate && (
								<span class="updated">
									· 업데이트 <FormattedDate date={updatedDate} />
								</span>
							)
						}
					</time>
					<span class="dot" aria-hidden="true">·</span>
					<ReadingTime minutes={reading} />
				</div>
				<h1>{title}</h1>
				{description && <p class="description">{description}</p>}
				{
					tags.length > 0 && (
						<div class="tags">
							{tags.map((t) => (
								<a href={`/tag/${encodeURIComponent(t)}/`} class="tag">
									#{t}
								</a>
							))}
						</div>
					)
				}
			</header>

			{
				heroImage && (
					<div class="hero-image">
						<img src={heroImage} alt="" />
					</div>
				)
			}

			<div class="prose">
				<slot />
			</div>

			<PostNav prev={prev} next={next} />
			<RelatedPosts posts={related} />
			<Giscus />
		</article>

		<Toc headings={headings} />
	</div>

	<CopyCodeButton />

	<style>
		.post-layout {
			display: grid;
			grid-template-columns: minmax(0, 1fr) 200px;
			gap: 1.25em;
			width: 100%;
		}
		article {
			min-width: 0;
			max-width: 75%;
		}
		@media (max-width: 1100px) {
			.post-layout {
				grid-template-columns: minmax(0, 1fr);
				max-width: 860px;
				margin: 0 auto;
			}
			article {
				max-width: none;
			}
			.post-layout :global(.toc) {
				display: none;
			}
		}
		.title {
			padding: 1em 0 2em;
		}
		.meta-row {
			display: flex;
			align-items: center;
			gap: 0.6em;
			flex-wrap: wrap;
			margin-bottom: 0.75em;
		}
		.dot {
			color: var(--fg-subtle);
		}
		.title time {
			color: var(--fg-subtle);
			font-size: 0.9em;
		}
		.updated {
			font-style: italic;
		}
		.draft {
			font-size: 0.78em;
			font-weight: 600;
			padding: 0.25em 0.7em;
			border-radius: 999px;
			background: #f59e0b22;
			color: #d97706;
			border: 1px solid #f59e0b55;
		}
		:global([data-theme='dark']) .draft,
		:global(html:not([data-theme='light'])) .draft {
			color: #fbbf24;
		}
		.title h1 {
			margin: 0 0 0.4em;
			font-size: 2.4em;
			line-height: 1.2;
			letter-spacing: -0.03em;
		}
		.description {
			margin: 0 0 1em;
			color: var(--fg-muted);
			font-size: 1.1em;
			line-height: 1.55;
		}
		.tags {
			display: flex;
			flex-wrap: wrap;
			gap: 0.45em;
		}
		.tag {
			font-size: 0.85em;
			color: var(--fg-muted);
			padding: 0.2em 0.6em;
			background: var(--bg-muted);
			border-radius: 999px;
			text-decoration: none;
			transition: color 0.15s ease, background 0.15s ease;
		}
		.tag:hover {
			color: var(--accent);
			background: var(--accent-soft);
		}
		.hero-image {
			margin: 1em 0 2.5em;
			border-radius: var(--radius-lg);
			overflow: hidden;
			box-shadow: var(--shadow-md);
		}
		.hero-image img {
			width: 100%;
			height: auto;
			display: block;
		}
		.prose {
			color: var(--fg);
			font-size: 1.02em;
		}
		.prose :global(h2) {
			margin-top: 2em;
			font-size: 1.6em;
			scroll-margin-top: 1em;
		}
		.prose :global(h3) {
			margin-top: 1.5em;
			font-size: 1.25em;
			scroll-margin-top: 1em;
		}
		.prose :global(p) {
			margin-bottom: 1.4em;
		}
		.prose :global(img) {
			border-radius: var(--radius-md);
			box-shadow: var(--shadow-sm);
			margin: 1em 0;
		}

		@media (max-width: 640px) {
			.title h1 {
				font-size: 1.9em;
			}
		}
	</style>
</BaseLayout>
