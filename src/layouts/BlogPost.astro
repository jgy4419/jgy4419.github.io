---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import CategoryBadge from '../components/CategoryBadge.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/Giscus.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category } = Astro.props;
---

<html lang="ko">
	<head>
		<BaseHead title={title} description={description} />
	</head>
	<body>
		<Header />
		<main>
			<article>
				<header class="title">
					<div class="meta-row">
						<CategoryBadge category={category} size="md" />
						<time>
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<span class="updated">
										· 업데이트 <FormattedDate date={updatedDate} />
									</span>
								)
							}
						</time>
					</div>
					<h1>{title}</h1>
					{description && <p class="description">{description}</p>}
				</header>

				{
					heroImage && (
						<div class="hero-image">
							<img src={heroImage} alt="" />
						</div>
					)
				}

				<div class="prose">
					<slot />
				</div>

				<Giscus />
			</article>
		</main>
		<Footer />

		<style>
			main {
				width: 760px;
				max-width: calc(100% - 2em);
				margin: 0 auto;
				padding: 3em 1em 1em;
			}
			.title {
				padding: 1em 0 2em;
				text-align: left;
			}
			.meta-row {
				display: flex;
				align-items: center;
				gap: 0.75em;
				flex-wrap: wrap;
				margin-bottom: 0.75em;
			}
			.title time {
				color: var(--fg-subtle);
				font-size: 0.9em;
			}
			.updated {
				font-style: italic;
			}
			.title h1 {
				margin: 0 0 0.4em;
				font-size: 2.5em;
				line-height: 1.2;
				letter-spacing: -0.03em;
			}
			.description {
				margin: 0;
				color: var(--fg-muted);
				font-size: 1.1em;
				line-height: 1.55;
			}
			.hero-image {
				margin: 1em 0 2.5em;
				border-radius: var(--radius-lg);
				overflow: hidden;
				box-shadow: var(--shadow-md);
			}
			.hero-image :global(img) {
				width: 100%;
				height: auto;
				display: block;
				border-radius: 0;
			}
			.prose {
				color: var(--fg);
				font-size: 1.02em;
			}
			.prose :global(h2) {
				margin-top: 2em;
				padding-top: 0.2em;
				font-size: 1.6em;
			}
			.prose :global(h3) {
				margin-top: 1.5em;
				font-size: 1.25em;
			}
			.prose :global(p) {
				margin-bottom: 1.4em;
			}
			.prose :global(img) {
				border-radius: var(--radius-md);
				box-shadow: var(--shadow-sm);
				margin: 1em 0;
			}

			@media (max-width: 640px) {
				.title h1 {
					font-size: 1.9em;
				}
			}
		</style>
	</body>
</html>
